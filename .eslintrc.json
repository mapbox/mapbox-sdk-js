{
  "extends": "eslint:recommended",
  "plugins": ["node"],
  "env": {
    "commonjs": true,
    "es6": true
  },
  "globals": {
    "Promise": true
  },
  "parserOptions": {
    "sourceType": "script",
    "ecmaVersion": 2017
  },
  "rules": {
    "strict": ["error"],
    "eqeqeq": ["error", "smart"],
    "node/no-unsupported-features": ["error", { "version": "8.0.0" }],
    "node/no-missing-require": "error"
  },
  "overrides": [
    {
      "files": ["test/*.js", "**/__tests__/*.js"],
      "env": {
        "jest": true,
        "es6": true,
        "node": true
      },
      "rules": {
        "no-console": "off",
        "no-unused-vars": "off"
      }
    }
  ]
}
